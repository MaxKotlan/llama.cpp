#version 450

// Parallel-ish BPE merge: one workgroup per word.
// Threads cooperate to find the best-ranked merge each iteration via reduction.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// Assumes max_word_len <= 256 (matches llama vocab limit).
const uint MAX_WORD_LEN = 256;

struct Merge {
    uint left;
    uint right;
    uint merged;
    uint rank;
};

struct WordMeta {
    uint offset;
    uint len;
};

struct LinkPair {
    int prev;
    int next;
};

layout(std430, binding = 0) readonly buffer MergeBuf {
    Merge merges[];
};

layout(std430, binding = 1) readonly buffer MetaBuf {
    WordMeta meta[];
};

layout(std430, binding = 2) buffer SymbolsBuf {
    uint symbols[];
};

layout(std430, binding = 3) buffer LinksBuf {
    LinkPair links[];
};

layout(std430, binding = 4) buffer OutSymbols {
    uint out_symbols[];
};

layout(std430, binding = 5) buffer OutMeta {
    WordMeta out_meta[];
};

layout(push_constant) uniform PushConsts {
    uint merge_count;
} pc;

shared uint   sh_symbols[MAX_WORD_LEN];
shared int    sh_next[MAX_WORD_LEN];
shared uint   sh_rank[32];
shared int    sh_left[32];
shared uint   sh_merged[32];

bool find_merge(uint left, uint right, out uint merged, out uint rank_out) {
    uint lo = 0;
    uint hi = pc.merge_count;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1;
        Merge m = merges[mid];
        if (left < m.left || (left == m.left && right < m.right)) {
            hi = mid;
        } else if (left > m.left || (left == m.left && right > m.right)) {
            lo = mid + 1;
        } else {
            merged = m.merged;
            rank_out = m.rank;
            return true;
        }
    }
    return false;
}

void main() {
    uint word_id = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    WordMeta m = meta[word_id];
    if (m.len == 0 || m.len > MAX_WORD_LEN) {
        if (lane == 0) out_meta[word_id] = WordMeta(0, 0);
        return;
    }

    // load symbols and init linked list into shared
    if (lane < m.len) {
        uint idx = m.offset + lane;
        sh_symbols[lane] = symbols[idx];
        sh_next[lane] = (lane + 1 < m.len) ? int(lane + 1) : -1;
    }
    barrier();

    uint current_len = m.len;

    while (true) {
        uint best_rank = 0xffffffffu;
        int best_left = -1;
        uint best_merged = 0;

        // each lane scans a strided subset of pairs
        for (uint i = lane; i + 1 < current_len; i += gl_WorkGroupSize.x) {
            uint left_id = sh_symbols[i];
            uint right_id = sh_symbols[i + 1];
            uint merged;
            uint rank;
            if (find_merge(left_id, right_id, merged, rank)) {
                if (rank < best_rank) {
                    best_rank = rank;
                    best_left = int(i);
                    best_merged = merged;
                }
            }
        }

        // write to shared for reduction
        sh_rank[lane] = best_rank;
        sh_left[lane] = best_left;
        sh_merged[lane] = best_merged;
        barrier();

        // reduction in shared memory
        for (uint offset = gl_WorkGroupSize.x / 2; offset > 0; offset >>= 1) {
            if (lane < offset) {
                uint o_rank = sh_rank[lane + offset];
                int  o_left = sh_left[lane + offset];
                uint o_merge = sh_merged[lane + offset];
                if (o_rank < sh_rank[lane]) {
                    sh_rank[lane] = o_rank;
                    sh_left[lane] = o_left;
                    sh_merged[lane] = o_merge;
                }
            }
            barrier();
        }

        best_rank = sh_rank[0];
        best_left = sh_left[0];
        best_merged = sh_merged[0];

        if (best_left < 0 || best_rank == 0xffffffffu) {
            break;
        }

        // lane 0 applies merge
        if (lane == 0) {
            uint left_idx = uint(best_left);
            uint right_idx = left_idx + 1;
            sh_symbols[left_idx] = best_merged;
            // shift symbols left by 1 from right_idx+1 .. end
            for (uint i = right_idx + 1; i < current_len; ++i) {
                sh_symbols[i - 1] = sh_symbols[i];
            }
            current_len -= 1;
        }
        barrier();
    }

    // write out
    if (lane == 0) {
        for (uint i = 0; i < current_len; ++i) {
            out_symbols[m.offset + i] = sh_symbols[i];
        }
        out_meta[word_id] = WordMeta(m.offset, current_len);
    }
}
