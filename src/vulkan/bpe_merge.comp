#version 450

// Parallel-ish BPE merge: one workgroup per word.
// Threads cooperatively identify non-conflicting local-minimum merges and apply merges.
// When approx_mode is enabled, only a single pass is executed (no convergence loop).
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// Assumes max_word_len <= 256 (matches llama vocab limit).
const uint MAX_WORD_LEN = 256;

struct Merge {
    uint left;
    uint right;
    uint merged;
    uint rank;
};

struct WordMeta {
    uint offset;
    uint len;
};

struct LinkPair {
    int prev;
    int next;
};

layout(std430, binding = 0) readonly buffer MergeBuf {
    Merge merges[];
};

layout(std430, binding = 1) readonly buffer MetaBuf {
    WordMeta meta[];
};

layout(std430, binding = 2) buffer SymbolsBuf {
    uint symbols[];
};

layout(std430, binding = 3) buffer LinksBuf {
    LinkPair links[];
};

layout(std430, binding = 4) buffer OutSymbols {
    uint out_symbols[];
};

layout(std430, binding = 5) buffer OutMeta {
    WordMeta out_meta[];
};

layout(push_constant) uniform PushConsts {
    uint merge_count;
    uint fast_mode;
    uint approx_mode;
} pc;

shared uint   sh_symbols[MAX_WORD_LEN];
shared uint   sh_rank[MAX_WORD_LEN];
shared uint   sh_merged[MAX_WORD_LEN];
shared uint   sh_winner[MAX_WORD_LEN];
shared uint   sh_temp[MAX_WORD_LEN];

bool find_merge(uint left, uint right, out uint merged, out uint rank_out) {
    uint lo = 0;
    uint hi = pc.merge_count;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1;
        Merge m = merges[mid];
        if (left < m.left || (left == m.left && right < m.right)) {
            hi = mid;
        } else if (left > m.left || (left == m.left && right > m.right)) {
            lo = mid + 1;
        } else {
            merged = m.merged;
            rank_out = m.rank;
            return true;
        }
    }
    return false;
}

void main() {
    uint word_id = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    WordMeta m = meta[word_id];
    if (m.len == 0 || m.len > MAX_WORD_LEN) {
        if (lane == 0) out_meta[word_id] = WordMeta(0, 0);
        return;
    }

    // load symbols into shared
    if (lane < m.len) {
        uint idx = m.offset + lane;
        sh_symbols[lane] = symbols[idx];
    }
    barrier();

    uint current_len = m.len;

    // run either one pass (approx) or loop to convergence (exact)
    bool more = true;
    while (more) {
        // compute candidate ranks
        if (pc.fast_mode == 0u) {
            // exact-ish: rank-based local minima
            for (uint i = lane; i < current_len; i += gl_WorkGroupSize.x) {
                if (i + 1 < current_len) {
                    uint left_id = sh_symbols[i];
                    uint right_id = sh_symbols[i + 1];
                    uint merged;
                    uint rank;
                    if (find_merge(left_id, right_id, merged, rank)) {
                        sh_rank[i] = rank;
                        sh_merged[i] = merged;
                    } else {
                        sh_rank[i] = 0xffffffffu;
                        sh_merged[i] = 0;
                    }
                } else {
                    sh_rank[i] = 0xffffffffu;
                    sh_merged[i] = 0;
                }
            }
            barrier();

            for (uint i = lane; i < current_len; i += gl_WorkGroupSize.x) {
                uint r = sh_rank[i];
                uint lrank = (i == 0) ? 0xffffffffu : sh_rank[i - 1];
                uint rrank = (i + 1 >= current_len - 1) ? 0xffffffffu : sh_rank[i + 1];
                bool win = (r != 0xffffffffu) && (r < lrank) && (r <= rrank);
                sh_winner[i] = win ? 1u : 0u;
            }
        } else {
            // fast approximate: merge any eligible pair, skipping neighbors
            for (uint i = lane; i < current_len; i += gl_WorkGroupSize.x) {
                if (i + 1 < current_len) {
                    uint left_id = sh_symbols[i];
                    uint right_id = sh_symbols[i + 1];
                    uint merged;
                    uint rank;
                    if (find_merge(left_id, right_id, merged, rank)) {
                        sh_rank[i] = rank;
                        sh_merged[i] = merged;
                        sh_winner[i] = 1u;
                    } else {
                        sh_rank[i] = 0xffffffffu;
                        sh_merged[i] = 0;
                        sh_winner[i] = 0u;
                    }
                } else {
                    sh_rank[i] = 0xffffffffu;
                    sh_merged[i] = 0;
                    sh_winner[i] = 0u;
                }
            }
        }
        barrier();

        // lane 0 compacts symbols after applying merges
        if (lane == 0) {
            uint out_len = 0;
            uint i = 0;
            while (i < current_len) {
                if (sh_winner[i] == 1u) {
                    sh_temp[out_len++] = sh_merged[i];
                    // skip merged pair
                    i += 2;
                } else {
                    sh_temp[out_len++] = sh_symbols[i];
                    i += 1;
                }
            }
            // detect no-change
            if (out_len == current_len) {
                current_len = out_len;
                for (uint k = 0; k < current_len; ++k) sh_symbols[k] = sh_temp[k];
                // no winners; break
                current_len = out_len;
                sh_rank[0] = 0; // signal done
            } else {
                current_len = out_len;
                for (uint k = 0; k < current_len; ++k) sh_symbols[k] = sh_temp[k];
                sh_rank[0] = 1; // signal continue
            }
        }
        barrier();

        if (pc.approx_mode == 1u) {
            more = false; // single pass
        } else {
            more = (sh_rank[0] != 0);
        }
        barrier();
    }

    // write out
    if (lane == 0) {
        for (uint i = 0; i < current_len; ++i) {
            out_symbols[m.offset + i] = sh_symbols[i];
        }
        out_meta[word_id] = WordMeta(m.offset, current_len);
    }
}
